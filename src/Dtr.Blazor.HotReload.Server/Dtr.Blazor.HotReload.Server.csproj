<Project Sdk="Microsoft.NET.Sdk.Web">
	<!--
		The hot reload server (see README.md), shipped as a .NET tool: watches the app's sources (and those of the libraries it uses),
		compiles every change in-memory, and pushes it to the browser.
	-->
	<PropertyGroup>
		<AssemblyName>Dtr.Blazor.HotReload.Server</AssemblyName>
		<RootNamespace>Dtr.Blazor.HotReload.Server</RootNamespace>
		<OutputType>Exe</OutputType>
		<IsPackable>true</IsPackable>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>dtr-blazor-hotreload</ToolCommandName>
		<PackageId>Dtr.Blazor.HotReload.Server</PackageId>
		<Description>The server side of Dtr.Blazor.HotReload, as a .NET tool (dtr-blazor-hotreload): watches a Blazor WebAssembly app and the libraries it uses, compiles every change in-memory (as an in-place update where possible), and pushes it to the browser.</Description>
	</PropertyGroup>
	<ItemGroup>
		<!--
			Compile against Roslyn, but don't ship it: at runtime, Roslyn is loaded from the SDK that built the app (see RoslynLoader),
			so it's always the same version as the source generators (Razor!) that come with that SDK.
		-->
		<PackageReference Include="Microsoft.CodeAnalysis.Common" ExcludeAssets="runtime" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" ExcludeAssets="runtime" />
		<!-- Same for the workspace layer, which is loaded from the SDK's dotnet-watch (together with the Edit-and-Continue engine) -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" ExcludeAssets="runtime" />
		<PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" ExcludeAssets="runtime" />
	</ItemGroup>
</Project>
