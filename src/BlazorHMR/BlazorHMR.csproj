<Project Sdk="Microsoft.NET.Sdk.Razor">
	<!--
		Browser side of the hot reload (see README.md): reference this from the Blazor WebAssembly app, in Debug builds only.
		The build/BlazorHMR.targets in the package is imported into the app's build automatically.
	-->
	<PropertyGroup>
		<AssemblyName>BlazorHMR</AssemblyName>
		<RootNamespace>BlazorHMR</RootNamespace>
		<IsPackable>true</IsPackable>
		<PackageId>BlazorHMR</PackageId>
		<Description>
			Hot reload for Blazor WebAssembly apps that applies (almost) any change while the app runs: in place where possible (keeping all state),
			otherwise by swapping in a new version of the app (carrying over state). Use together with the BlazorHMR.Server tool. Reference it in Debug builds only.
		</Description>
		<!-- Ship the PDB in the package, for line numbers in stack traces -->
		<DebugType>portable</DebugType>
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
	</PropertyGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="BlazorHMR.UnitTest" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\BlazorHMR.Protocol\BlazorHMR.Protocol.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!-- Imported into the build of the (directly) referencing app -->
		<None Include="build/BlazorHMR.targets" Pack="true" PackagePath="build/" />
	</ItemGroup>
</Project>
