<Project>
	<!--
		Part of the BlazorHMR package, imported into the build of the app that references it.
		Only does something in Debug builds (opt out with -p:BlazorHMR=false):

		- Defines HOTRELOAD, so Program.cs can call UseHotReload().
		- Captures the exact compiler command line of the app, so the hot reload server (BlazorHMR.Server) can recompile it
		  on-the-fly with the same references, source generators (incl. Razor), defines, editorconfigs, etc.
	-->
	<PropertyGroup Condition="'$(BlazorHMR)' != 'false'">
		<!-- Makes the Csc task output its command line as @(CscCommandLineArgs) -->
		<ProvideCommandLineArgs>true</ProvideCommandLineArgs>
	</PropertyGroup>

	<Target
		Name="BlazorHMRWriteCompilerArgs"
		AfterTargets="CoreCompile"
		Condition="'$(BlazorHMR)' != 'false' and @(CscCommandLineArgs) != ''"
	>
		<WriteLinesToFile
			File="$(IntermediateOutputPath)blazor-hmr.rsp"
			Lines="@(CscCommandLineArgs)"
			Overwrite="true"
			WriteOnlyWhenDifferent="true"
		/>
		<WriteLinesToFile
			File="$(IntermediateOutputPath)blazor-hmr.txt"
			Lines="ProjectDir=$(MSBuildProjectDirectory);RoslynPath=$(RoslynTargetsPath);IntermediateAssembly=$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)$(TargetFileName)'))"
			Overwrite="true"
			WriteOnlyWhenDifferent="true"
		/>
	</Target>
</Project>
