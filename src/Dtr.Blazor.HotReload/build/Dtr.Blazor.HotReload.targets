<Project>
	<!--
		Part of the Dtr.Blazor.HotReload package, imported into the build of the app that references it.
		Only does something in Debug builds (opt out with -p:DtrHotReload=false):

		- Defines HOTRELOAD, so Program.cs can call UseHotReload().
		- Captures the exact compiler command line of the app, so the hot reload server (Dtr.Blazor.HotReload.Server) can recompile it
		  on-the-fly with the same references, source generators (incl. Razor), defines, editorconfigs, etc.
	-->
	<PropertyGroup>
		<DtrHotReloadEnabled Condition="'$(Configuration)' == 'Debug' and '$(DtrHotReload)' != 'false'">true</DtrHotReloadEnabled>
	</PropertyGroup>

	<PropertyGroup Condition="'$(DtrHotReloadEnabled)' == 'true'">
		<DefineConstants>$(DefineConstants);HOTRELOAD</DefineConstants>
		<!-- Makes the Csc task output its command line as @(CscCommandLineArgs) -->
		<ProvideCommandLineArgs>true</ProvideCommandLineArgs>
	</PropertyGroup>

	<Target
		Name="DtrHotReloadWriteCompilerArgs"
		AfterTargets="CoreCompile"
		Condition="'$(DtrHotReloadEnabled)' == 'true' and '@(CscCommandLineArgs)' != ''"
	>
		<WriteLinesToFile
			File="$(IntermediateOutputPath)dtr-hotreload.rsp"
			Lines="@(CscCommandLineArgs)"
			Overwrite="true"
			WriteOnlyWhenDifferent="true"
		/>
		<WriteLinesToFile
			File="$(IntermediateOutputPath)dtr-hotreload.txt"
			Lines="ProjectDir=$(MSBuildProjectDirectory);RoslynPath=$(RoslynTargetsPath);IntermediateAssembly=$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)$(TargetFileName)'))"
			Overwrite="true"
			WriteOnlyWhenDifferent="true"
		/>
	</Target>
</Project>
