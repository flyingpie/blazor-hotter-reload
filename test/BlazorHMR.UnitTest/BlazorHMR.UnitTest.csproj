<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AssemblyName>BlazorHMR.UnitTest</AssemblyName>
		<RootNamespace>BlazorHMR.UnitTest</RootNamespace>
		<Nullable>annotations</Nullable>
		<EnableNETAnalyzers>false</EnableNETAnalyzers>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\src\BlazorHMR\BlazorHMR.csproj" />
		<ProjectReference Include="..\..\src\BlazorHMR.Protocol\BlazorHMR.Protocol.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!-- To compile two versions of the same types in the tests -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="MSTest.TestAdapter" />
		<PackageReference Include="MSTest.TestFramework" />
	</ItemGroup>
</Project>
