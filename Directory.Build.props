<Project>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<AnalysisMode>Recommended</AnalysisMode>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<!--
		<TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
		-->

		<!-- Packaging -->
		<!-- Bump this for every release: consumers cache packages by version. -->
		<VersionPrefix>0.1.14</VersionPrefix>
		<Authors>Marco van den Oever</Authors>
		<Copyright>Marco van den Oever</Copyright>
		<PackageTags>blazor;webassembly;desktop;photino;hotreload;hot-reload;hmr</PackageTags>
		<PackageOutputPath>$(MSBuildThisFileDirectory)artifacts</PackageOutputPath>
		<IsPackable>false</IsPackable>
		<EmbedAllSources>true</EmbedAllSources>
	</PropertyGroup>
</Project>
